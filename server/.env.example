# Miljøvariablene TS-serveren leser. Kopier til `server/.env` og fyll inn verdiene.
# `server/.env` er ignorert av git og Docker. Ikke legg hemmeligheter i denne fila.
#
# Serveren leser ikke fila selv. Den leser bare miljøet (`server/start.ts`).
# Fila leses av `scripts/testbase/ekte_innlogging.ts`, og en variabel i skallet går
# foran verdien i fila.

# --- Datalaget (påkrevd for serveren) ---
# Tilkoblingsstrengen til en migrert base i SQL Server, som en innlogging i rollen
# koe_runtime (`server/start.ts`).
KOE_DATALAG_TILKOBLING=
# Adressen serveren lytter på. 127.0.0.1 når den ikke er satt.
KOE_LYTTEADRESSE=
# For `server/registrering.ts`: en bruker med koe_driftsrolle.
KOE_DRIFT_TILKOBLING=

# --- Miljøet ---
# development gir sesjonskapselen koe_session over http. Ellers kreves HTTPS
# (__Host-koe_session).
APP_ENV=development
# Opprinnelsen til frontenden, uten / til slutt.
AUTH_FRONTEND_URL=http://localhost:5173
# Hvor lenge medlemslisten fra Catenda gjelder, 60–3600 sekunder. 900 når den ikke er satt.
AUTH_MEMBERSHIP_MAX_AGE_SECONDS=

# --- Catenda-applikasjonen og innloggingen (påkrevd for ekte_innlogging.ts) ---
CATENDA_CLIENT_ID=
CATENDA_CLIENT_SECRET=
CATENDA_LOGIN_REDIRECT_URI=http://localhost:5173/api/auth/catenda/callback
# Et token integrasjonen bruker til det utløper. Valgfritt.
CATENDA_ACCESS_TOKEN=
# Erstatter Catenda, for eksempel med token-brokeren (#806). Må være en https-origin,
# eller localhost over http med APP_ENV=development. Valgfritt.
CATENDA_GRUNNADRESSE=
# Catenda-prosjektet og dokumentbiblioteket ekte_innlogging.ts registrerer.
CATENDA_PROJECT_ID=
CATENDA_LIBRARY_ID=

# --- Webhooken fra Catenda (valgfritt; uten hemmeligheten svarer webhooken 404) ---
# Hemmeligheten i stien, minst 32 tegn: bare bokstavene a–z og A–Z, sifre, - og _.
WEBHOOK_SECRET_PATH=
# Kall per minutt. 100 når den ikke er satt.
RATE_LIMIT_WEBHOOK=

# --- Entra-innloggingen og HR-kopien (valgfritt) ---
# Settes alle fire eller ingen av ENTRA_* for innloggingen.
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=
ENTRA_AUTHORITY=
# HR-kopien fra Graph bruker ENTRA_CLIENT_ID og ENTRA_CLIENT_SECRET med denne tenanten.
HR_TENANT_ID=
