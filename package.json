{
	"name": "endringsmeldinger",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*",
		"#kjerne/*": "./kjerne/*"
	},
	"engines": {
		"node": "^22.19.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:error": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"prepare": "husky",
		"server": "node server/start.ts"
	},
	"lint-staged": {
		"*": "prettier --write --ignore-unknown"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.2.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/mssql": "12.3.0",
		"@types/node": "22.20.4",
		"axe-core": "^4.14.0",
		"eslint": "^9.18.0",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"husky": "^9.1.7",
		"jsdom": "^28.1.0",
		"lint-staged": "^16.3.3",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.2.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@oslokommune/punkt-assets": "19.14.2",
		"@pdf-lib/fontkit": "1.1.1",
		"@tanstack/svelte-query": "^6.1.0",
		"bits-ui": "^2.16.2",
		"date-fns": "^4.1.0",
		"jose": "6.2.12",
		"lucide-svelte": "^0.475.0",
		"mssql": "12.7.1",
		"pdf-lib": "1.17.1",
		"zod": "^4.6.7"
	},
	"overrides": {
		"pg-cloudflare": "1.4.0",
		"pg-connection-string": "2.14.0",
		"pg-protocol": "1.16.0",
		"joi": "17.13.9",
		"runed": "0.38.0"
	}
}
