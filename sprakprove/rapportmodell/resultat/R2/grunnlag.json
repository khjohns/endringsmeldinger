            {
              "gjelder": "55400000-0000-4000-8000-000000010039",
              "laast": "Byggherrens svar på grunnlaget i TEs krav i brev 2 av 20. september 2026: Byggherren avslår grunnlaget.",
              "utdypning": "Utdypning i bevis-saken."
            },
            {
              "gjelder": "55400000-0000-4000-8000-000000010040",
              "laast": "Byggherrens svar på kravet om justering av vederlaget i TEs krav i brev 5 av 23. september 2026: Prinsipalt: byggherren avslår grunnlaget (se svaret på grunnlaget). Byggherren gjør ikke gjeldende at varselet om vederlagsjustering etter NS 8407 § 34.1.2 i brev 3 av 21. september 2026 kom for sent. Byggherren aksepterer beregningsmåten i TEs tilbud (NS 8407 § 34.2.2). Subsidiært: byggherren godkjenner 120 000 kr eks. mva. av de krevde 150 000 kr eks. mva.",
              "utdypning": "Utdypning i bevis-saken."
            },
            {
              "gjelder": "55400000-0000-4000-8000-000000010041",
              "laast": "Byggherrens svar på kravet om fristforlengelse i TEs krav i brev 4 av 22. september 2026: Prinsipalt: byggherren avslår grunnlaget (se svaret på grunnlaget). Subsidiært: byggherren gjør gjeldende at varselet om fristforlengelse etter NS 8407 § 33.4 i brev 4 av 22. september 2026 kom for sent. Byggherren legger til grunn at fremdriften hindres som følge av forholdet (NS 8407 § 33.1). Byggherren gjør ikke gjeldende at kravet om fristforlengelse ble spesifisert for sent (NS 8407 § 33.6.1). Videre subsidiært: byggherren godkjenner 10 dager av de krevde 20 dager.",
              "utdypning": "Utdypning i bevis-saken."
            }
          ]
        }
